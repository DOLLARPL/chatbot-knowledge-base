# Parametry pracy chatbota. Skopiuj do .env i uzupełnij.
# Ten plik jest w repozytorium, .env NIE.

# --- dostęp do modelu ---
OPENROUTER_API_KEY=
MODEL=google/gemini-2.5-flash-lite
FALLBACK_MODEL=deepseek/deepseek-v4-flash

# ceny za 1 mln tokenów w USD (do liczenia kosztu w panelu)
PRICE_IN=0.10
PRICE_OUT=0.40
USD_PLN=3.80

# --- dane firmy (dla tego jednego kontenera) ---
TENANT=demo
COMPANY_NAME=AutoExpert
COMPANY_CONTACT=telefon 512 300 400

# --- limity bezpieczeństwa ---
MAX_QUESTION_CHARS=500
RATE_LIMIT_PER_10MIN=20
DAILY_LIMIT=300
MAX_TOKENS=300
TEMPERATURE=0.2

# Domeny, z których wolno wołać API (puste = bez sprawdzania, tryb lokalny).
# Na produkcji wpisz adresy, np.: ALLOWED_ORIGINS=https://chat.jnxautomation.pl,https://demo.jnxautomation.pl
ALLOWED_ORIGINS=

# Hasło do panelu (etap 3).
ADMIN_PASSWORD=
